// @see - https://www.electron.build/configuration/configuration
{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.vifug.lyrics",
  "asar": true,
  // Explicit so electron-builder never has to sniff node_modules for the
  // version - bun hoists electron to the workspace root, where detection
  // fails ("Cannot compute electron version"). Keep in sync with bun.lock.
  "electronVersion": "30.5.1",
  // The native NDI addon is N-API (ABI-stable) and is compiled explicitly in
  // CI, so electron-builder must NOT try to rebuild native deps against Electron
  // headers (that would need the NDI SDK at rebuild time and can fail). libsql
  // ships its own prebuilt binaries, so this is safe for it too.
  "npmRebuild": false,
  "asarUnpack": [
    "**/*.node",
    "node_modules/@libsql/**",
    "node_modules/libsql/**",
    // Native NDI sender: the .node is covered above, but its NDI runtime DLL
    // (Processing.NDI.Lib.*.dll) must be unpacked too or the addon can't load.
    "node_modules/@stagetimerio/grandiose/**",
    "node_modules/grandiose/**"
  ],
  "extraResources": [
    { "from": "../web/local.db", "to": "seed.db" }
  ],
  "productName": "Vifug",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist",
    "dist-electron",
    "web-dist"
  ],
  "mac": {
    "icon": "build/icon.png",
    "target": [
      "dmg"
    ],
    // Version-independent name (no spaces): the landing page hardcodes
    // .../releases/latest/download/<name>, which must stay stable across
    // releases. The release tag carries the version.
    "artifactName": "VifugLyrics-Mac-Installer.${ext}"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "VifugLyrics-Windows-Setup.${ext}",
    // The Visual C++ runtime that libsql's native module needs, placed beside
    // that module so Windows finds it there first. See win-runtime.ts for why
    // it is not simply next to Vifug.exe.
    "extraResources": [
      {
        "from": "build/win-runtime",
        "to": "app.asar.unpacked/node_modules/@libsql/win32-x64-msvc",
        "filter": ["*.dll"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    /*
     * No choice of folder, deliberately.
     *
     * A user who ran the installer twice and accepted a different folder the
     * second time ended up with two complete copies of Vifug and two desktop
     * shortcuts - which is exactly what turned up in a support video. The old
     * copy is not upgraded, it just sits there, and whichever icon they happen
     * to click decides which version they get. Nobody installing a worship
     * app wants to pick a directory; letting them costs far more than it
     * gives.
     */
    "allowToChangeInstallationDirectory": false,
    /*
     * And no choice of scope either.
     *
     * The other way to end up with two Vifugs is to install once "for me" and
     * once "for anyone who uses this computer": Windows records those in
     * different registry hives, so the installer does not see the other one
     * and does not replace it. Refusing to elevate pins every install to the
     * per-user location, which is where it was going anyway - the firewall
     * rule is the only thing elevation bought, and that already falls back to
     * being added from Settings when it cannot run.
     */
    "allowElevation": false,
    "deleteAppDataOnUninstall": false,
    // Adds the inbound firewall rule companion screens need. Best effort: a
    // per-user install is unelevated and it will fail, in which case the app
    // offers to add it from Settings instead.
    "include": "build/installer.nsh"
  },
  "linux": {
    "icon": "build/icon.png",
    "category": "AudioVideo",
    "target": [
      "AppImage"
    ],
    "artifactName": "VifugLyrics-Linux.${ext}"
  }
}

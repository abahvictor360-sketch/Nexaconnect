# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# Object storage for media (backgrounds, deck images).
# Optional locally - the desktop app writes to disk. REQUIRED on a hosted
# deployment, which has no writable disk. Cloudflare R2, Tigris or AWS S3; the
# client is configured region-"auto" + virtual-hosted style, which suits R2.
# The bucket also needs a CORS rule allowing PUT from the app's origin, or the
# browser's direct upload is blocked and the app silently falls back to disk.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# ---------------------------------------------------------------------------
# The model. Optional: without it the app runs in offline demo mode, quoting
# knowledge base lines verbatim instead of writing replies. Add the key and
# restart, and the app switches to Claude on its own — nothing else to change.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
# ANTHROPIC_MODEL=claude-sonnet-4-6
# ANTHROPIC_EFFORT=low          # low | medium | high | max, or "off" to omit it

# ---------------------------------------------------------------------------
# The database. Optional locally: with these unset, the app uses a SQLite file
# at data/nexaconnect.db and needs no setup at all.
#
# Set BOTH of these to use hosted Postgres instead. Required on Vercel and any
# other serverless host, where the filesystem is read-only and per-instance.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses row level security. It is server-only:
# never prefix it with NEXT_PUBLIC_, and never reference it in client code.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role secret from Project Settings -> API Keys>

# ---------------------------------------------------------------------------
# Sign-in. Optional: without these the app runs open — anyone can chat as a
# guest and the agent console is unguarded. Always set them on a deployment.
#
# These two ARE public. They are safe in the browser and are the only Supabase
# values that ever should be: the anon key is limited by row level security.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key from Project Settings -> API Keys>

# Local SQLite file location, if you want it somewhere else.
# NEXACONNECT_DB=./data/nexaconnect.db
